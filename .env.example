# Copy this file to .env and fill in the values.
# All variables below are required — app startup fails fast if any are missing
# (see validate_environment() in settings.py).

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Observability (https://logfire.pydantic.dev)
LOGFIRE_TOKEN=

# Web search
PERPLEXITY_API_KEY=

# Postgres connection (used by db/ and alembic migrations)
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB=stock_trader

# Firebase Admin SDK
# Absolute path to the Firebase service account JSON file.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Keep this file OUT of version control.
GOOGLE_APPLICATION_CREDENTIALS=
